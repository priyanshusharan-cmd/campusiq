# Google AI Studio key for a project on the free tier. Never use EXPO_PUBLIC_ for secrets.
GEMINI_API_KEY=
AI_HOST=127.0.0.1
AI_PORT=8787
# Required if AI_HOST=0.0.0.0 for a phone on the same Wi-Fi.
AI_SERVER_TOKEN=
# Browser origins allowed to call this server (comma separated).
AI_ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:8081,http://127.0.0.1:8081
